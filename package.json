{
  "name": "@marigoldlabs/web3-tester",
  "version": "0.4.1",
  "type": "module",
  "description": "A Playwright, Anvil, and Viem based Web3 E2E harness with an injected programmable wallet provider.",
  "license": "MIT",
  "keywords": [
    "playwright",
    "anvil",
    "viem",
    "metamask",
    "walletconnect",
    "web3",
    "ethereum",
    "e2e",
    "testing",
    "wallet",
    "eip-1193",
    "dapp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndyMarigoldLabs/web3-tester.git"
  },
  "bugs": {
    "url": "https://github.com/AndyMarigoldLabs/web3-tester/issues"
  },
  "homepage": "https://github.com/AndyMarigoldLabs/web3-tester#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./anvil": {
      "types": "./dist/anvil.d.ts",
      "import": "./dist/anvil.js"
    },
    "./erc20": {
      "types": "./dist/erc20.d.ts",
      "import": "./dist/erc20.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "import": "./dist/matchers.js"
    },
    "./walletconnect": {
      "types": "./dist/walletconnect.d.ts",
      "import": "./dist/walletconnect.js"
    },
    "./wallet-personas": {
      "types": "./dist/wallet-personas.d.ts",
      "import": "./dist/wallet-personas.js"
    },
    "./safe": {
      "types": "./dist/safe.d.ts",
      "import": "./dist/safe.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "import": "./dist/benchmark.js"
    },
    "./transactions": {
      "types": "./dist/transactions.d.ts",
      "import": "./dist/transactions.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./live-fixtures": {
      "types": "./dist/live-fixtures.d.ts",
      "import": "./dist/live-fixtures.js"
    },
    "./mock-wallet-controller": {
      "types": "./dist/mock-wallet-controller.d.ts",
      "import": "./dist/mock-wallet-controller.js"
    },
    "./private-key-rpc-client": {
      "types": "./dist/private-key-rpc-client.d.ts",
      "import": "./dist/private-key-rpc-client.js"
    },
    "./real-wallet": {
      "types": "./dist/real-wallet.d.ts",
      "import": "./dist/real-wallet.js"
    },
    "./real-wallet-extension": {
      "types": "./dist/real-wallet-extension.d.ts",
      "import": "./dist/real-wallet-extension.js"
    },
    "./real-wallet-extension-fixtures": {
      "types": "./dist/real-wallet-extension-fixtures.d.ts",
      "import": "./dist/real-wallet-extension-fixtures.js"
    },
    "./real-wallet-cache": {
      "types": "./dist/real-wallet-cache.d.ts",
      "import": "./dist/real-wallet-cache.js"
    },
    "./real-wallet-fixtures": {
      "types": "./dist/real-wallet-fixtures.d.ts",
      "import": "./dist/real-wallet-fixtures.js"
    },
    "./metamask-extension": {
      "types": "./dist/metamask-extension.d.ts",
      "import": "./dist/metamask-extension.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:contracts": "node scripts/build-contracts.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepare": "npm run build",
    "test": "playwright test --project=library",
    "test:browsers": "playwright test --project=browser-chromium --project=browser-firefox --project=browser-webkit",
    "test:fjord": "playwright test --project=fjord",
    "test:all": "playwright test",
    "smoke:real-wallet": "node scripts/real-wallet-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck examples/playwright.config.ts examples/local-wallet.spec.ts examples/live-sepolia.spec.ts",
    "verify": "npm run typecheck && npm run typecheck:examples && npm run build && npm test"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.56.0 <2",
    "@walletconnect/sign-client": ">=2.17 <3",
    "@walletconnect/types": ">=2.17 <3",
    "@walletconnect/utils": ">=2.17 <3",
    "viem": ">=2.39.3 <3"
  },
  "peerDependenciesMeta": {
    "@walletconnect/sign-client": { "optional": true },
    "@walletconnect/types": { "optional": true },
    "@walletconnect/utils": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.1",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/types": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "typescript": "^5.9.3",
    "viem": "^2.52.0"
  }
}
